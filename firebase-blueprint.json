{
  "entities": {
    "School": {
      "title": "School",
      "description": "School entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Classroom entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "schoolId": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "academicYear": { "type": "string" },
        "term": { "type": "string" }
      },
      "required": ["id", "name", "schoolId"]
    },
    "Student": {
      "title": "Student",
      "description": "Student entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentNumber": { "type": "string" },
        "studentCode": { "type": "string" },
        "name": { "type": "string" },
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "lockedStatus": { "type": "string" },
        "avatar": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "studentNumber", "name", "schoolId", "classId"]
    },
    "AttendanceStatusConfig": {
      "title": "AttendanceStatusConfig",
      "description": "Attendance status configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "bgColor": { "type": "string" },
        "borderColor": { "type": "string" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["id", "code", "label", "color"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance record for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "status": { "type": "string" },
        "checkInTime": { "type": "string" },
        "timestamp": { "type": "number" },
        "note": { "type": "string" }
      },
      "required": ["id", "date", "schoolId", "classId", "studentId", "status", "checkInTime", "timestamp"]
    },
    "ArtAssignment": {
      "title": "ArtAssignment",
      "description": "Art assignment or project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "maxScore": { "type": "number" },
        "dueDate": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "schoolId", "classId", "title", "maxScore"]
    },
    "SubmissionGrade": {
      "title": "SubmissionGrade",
      "description": "Student score and grade for an art assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "score": { "type": "number" },
        "feedback": { "type": "string" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "assignmentId", "studentId", "score", "status", "updatedAt"]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Schools directory"
    },
    "/classes/{classId}": {
      "schema": "ClassRoom",
      "description": "Classrooms"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Students roster"
    },
    "/statuses/{statusId}": {
      "schema": "AttendanceStatusConfig",
      "description": "Attendance status tags"
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance records"
    },
    "/assignments/{assignmentId}": {
      "schema": "ArtAssignment",
      "description": "Art assignments"
    },
    "/grades/{gradeId}": {
      "schema": "SubmissionGrade",
      "description": "Art scores and grades"
    }
  }
}
